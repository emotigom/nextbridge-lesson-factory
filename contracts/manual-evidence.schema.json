{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextbridge.example/contracts/manual-evidence.schema.json",
  "title": "Nextbridge Manual Gate Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "courseId",
    "gate",
    "status",
    "subjectSha256",
    "capturedAt",
    "reviewer",
    "environment",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "courseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "gate": {
      "enum": [
        "BROWSER_FILE_SMOKE",
        "VIEWPORT_1440_900_375_812",
        "JSON_ROUNDTRIP_PRINT",
        "WINDOWS_POWERPOINT_SMOKE",
        "FONT_PORTABILITY_REFLOW",
        "INDEPENDENT_INSTRUCTOR_REHEARSAL",
        "STUDENT_FIELD_PILOT"
      ]
    },
    "status": {"enum": ["PASS", "FAIL"]},
    "subjectSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capturedAt": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "application": {"type": "string"},
        "version": {"type": "string"},
        "device": {"type": "string"},
        "network": {"type": "string"},
        "viewport": {"type": "string"}
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "metrics": {"type": "object"},
    "notes": {"type": "string"}
  }
}
