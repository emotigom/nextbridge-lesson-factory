{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextbridge.example/contracts/chatgpt-handoff.schema.json",
  "title": "Nextbridge ChatGPT Lesson Design Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","handoffType","courseId","title","designState","sourcePolicy","courseMap","conceptPolicy","storyboards","approvals"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "handoffType": {"const": "CHATGPT_LESSON_DESIGN"},
    "courseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1},
    "designState": {"type": "string", "pattern": "^(COURSE_MAP_APPROVED|SESSION_[1-9][0-9]*_APPROVED|ALL_CONTENT_APPROVED)$"},
    "privateConversationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detailPublished"],
      "properties": {
        "detailPublished": {"const": false},
        "conversationRef": {"type": ["string", "null"]},
        "conversationDigestSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourcePolicy": {"type": "object"},
    "courseMap": {"type": "object"},
    "conceptPolicy": {"type": "object"},
    "storyboards": {"type": "array", "items": {"type": "object"}},
    "qualityScore": {"type": ["object", "null"]},
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["courseMap","sessions","allContent"],
      "properties": {
        "courseMap": {"$ref": "#/$defs/approval"},
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["session","status","reviewer","approvedAt"],
            "properties": {
              "session": {"type": "integer", "minimum": 1},
              "status": {"enum": ["PENDING","APPROVED"]},
              "reviewer": {"type": ["string", "null"]},
              "approvedAt": {"type": ["string", "null"]}
            }
          }
        },
        "allContent": {"$ref": "#/$defs/approval"}
      }
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status","reviewer","approvedAt"],
      "properties": {
        "status": {"enum": ["PENDING","APPROVED"]},
        "reviewer": {"type": ["string", "null"]},
        "approvedAt": {"type": ["string", "null"]}
      }
    }
  }
}
