{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextbridge.example/contracts/course-map.schema.json",
  "title": "Nextbridge Course Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "courseId", "locked", "flow", "sessions"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "courseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "locked": {"type": "boolean"},
    "deliveryProfile": {
      "enum": ["experience-first", "guided-build", "explain-practice"]
    },
    "practiceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "studentBuild"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "studentBuild": {"type": "string", "minLength": 1}
      }
    },
    "flow": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session", "question", "coreExperience", "minimumOutput"],
        "properties": {
          "session": {"type": "integer", "minimum": 1},
          "question": {"type": "string", "minLength": 1},
          "coreExperience": {"type": "string", "minLength": 1},
          "minimumOutput": {"type": "string", "minLength": 1},
          "status": {"enum": ["DRAFT", "APPROVED"]}
        }
      }
    }
  }
}
