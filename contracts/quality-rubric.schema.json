{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextbridge.example/contracts/quality-rubric.schema.json",
  "title": "Nextbridge Lesson Quality Score",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rubricVersion", "courseId", "reviewer", "criteria", "overall", "hardGatesPass"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "rubricVersion": {"type": "string", "minLength": 1},
    "courseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "reviewer": {"type": "string", "minLength": 1},
    "criteria": {
      "type": "object",
      "minProperties": 20,
      "maxProperties": 20,
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 5}
    },
    "overall": {"type": "number", "minimum": 0, "maximum": 100},
    "hardGatesPass": {"type": "boolean"},
    "notes": {"type": "string"}
  }
}
