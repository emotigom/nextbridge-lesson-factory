{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextbridge.example/contracts/storyboard.schema.json",
  "title": "Nextbridge Session Storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "courseId", "session", "status", "timing", "teachingBeats", "slides"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "courseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "session": {"type": "integer", "minimum": 1},
    "status": {"enum": ["DRAFT", "APPROVED"]},
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coreTargetMinutes", "fullTargetMinutes", "coreToleranceMinutes"],
      "properties": {
        "coreTargetMinutes": {"type": "number", "minimum": 1},
        "fullTargetMinutes": {"type": "number", "minimum": 1},
        "coreToleranceMinutes": {"type": "number", "minimum": 0}
      }
    },
    "teachingBeats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["beat", "title"],
        "properties": {
          "beat": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1}
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide", "teachingBeat", "priority", "role", "title", "studentText", "visual", "studentAction", "teacherScript", "expectedResponses", "stuckPrompt", "transition", "minutes", "skippable", "conceptsIntroduced"],
        "properties": {
          "slide": {"type": "integer", "minimum": 1},
          "teachingBeat": {"type": "integer", "minimum": 1},
          "priority": {"enum": ["CORE", "BUFFER"]},
          "role": {"enum": ["LOOK", "THINK", "CHOOSE", "TRY", "TALK", "LEARN", "CHECK", "VIDEO"]},
          "title": {"type": "string", "minLength": 1},
          "studentText": {"type": "string"},
          "visual": {"type": "string"},
          "studentAction": {"type": "string"},
          "teacherScript": {"type": "string"},
          "expectedResponses": {"type": "array", "items": {"type": "string"}},
          "stuckPrompt": {"type": "string"},
          "transition": {"type": "string"},
          "minutes": {"type": "number", "minimum": 0},
          "skippable": {"type": "boolean"},
          "conceptsIntroduced": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
